{
  "manifest_version": 3,
  "name": "doc2pdf",
  "description": "Xuất tài liệu Studocu/Scribd ra PDF (chụp nội dung trang đang xem). Dùng cho mục đích học tập cá nhân.",
  "version": "1.1.2",
  "permissions": ["cookies"],
  "host_permissions": [
    "*://*.studocu.com/*",
    "*://*.studeersnel.nl/*",
    "*://*.studocu.id/*",
    "*://*.studocu.vn/*",
    "*://*.scribd.com/*",
    "*://*.scribdassets.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studeersnel.nl/*",
        "*://*.studocu.id/*",
        "*://*.studocu.vn/*",
        "*://*.scribd.com/*"
      ],
      "js": ["lib.js", "html2canvas.min.js", "content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.studocu.com/*",
        "*://*.studeersnel.nl/*",
        "*://*.studocu.id/*",
        "*://*.studocu.vn/*",
        "*://*.scribd.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
